# API key de Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# Remitente: debe pertenecer a un dominio verificado en Resend.
# Para probar sin dominio propio podés usar "onboarding@resend.dev"
# (en ese modo Resend solo entrega al email de tu propia cuenta).
CONTACT_FROM_EMAIL="ACORD@R Web <web@acordar.com.ar>"

# Casilla que recibe las consultas del formulario
CONTACT_TO_EMAIL=consultas@acordar.com.ar

# URL pública del sitio (metadatos y Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.acordar.com.ar
